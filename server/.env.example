PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/medistand
JWT_SECRET=your_jwt_secret_here
DEFAULT_TIMEZONE=Asia/Kolkata

# Caregiver Email Notifications (Configure with your real SMTP or Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_caregiver_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="MediStand Alerts" <your_caregiver_email@gmail.com>
ENABLE_EMAIL_NOTIFICATIONS=false

# Demo & Simulation Mode
DEMO_MODE=true
